flowchart LR
  classDef pkg fill:#d5e8d4,stroke:#82b366;
  classDef pub fill:#fff2cc,stroke:#d6b656;
  classDef sec fill:#f8cecc,stroke:#b85450;
  classDef chk fill:#dae8fc,stroke:#6c8ebf;
  P0["first package P0<br/>(fresh randomness)"]:::pkg --> B1["batch 7 publishes:<br/>P0 · slot s marked OCCUPIED"]:::pub
  P1["revote: fresh package P1<br/>(no reference to P0)"]:::pkg --> B2["batch 12 publishes:<br/>P1 · nothing about slot s"]:::pub
  B1 --> L1["write log of batch 7 (encrypted):<br/>P0 wrote slot s"]:::sec
  B2 --> L2["write log of batch 12 (encrypted):<br/>P1 wrote slot s"]:::sec
  L1 --> T["at tally, θ wardens open the logs:<br/>slot s → its package in the<br/>highest batch = P1 (last write wins)"]:::chk
  L2 --> T
  O["the public sees: one more package,<br/>one more overwrite in the batch count,<br/>never which slot"]:::pub
  B2 --- O
  subgraph BATCH["checked by the batch program"]
    C1["census: this voter owns slot s"]:::chk
    C2["at most 1 ballot per slot per batch"]:::chk
    C3["log entry = the package's slot"]:::chk
  end
