<mxfile host="drawio"><diagram name="batch-program" id="batch-program"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=none;strokeColor=#000000;fontFamily=Courier New;verticalAlign=top;align=center;spacingTop=4;spacingLeft=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1210" height="760" as="geometry"/></mxCell><mxCell id="c4" value="PRIVATE INPUT BLOCKS" style="text;html=1;whiteSpace=wrap;fontSize=15;fontFamily=Courier New;align=center;verticalAlign=middle;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="16" y="8" width="390" height="26" as="geometry"/></mxCell><mxCell id="c5" value="GROUPS OF CONSTRAINTS" style="text;html=1;whiteSpace=wrap;fontSize=15;fontFamily=Courier New;align=center;verticalAlign=middle;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="8" width="420" height="26" as="geometry"/></mxCell><mxCell id="c6" value="PUBLIC OUTPUTS" style="text;html=1;whiteSpace=wrap;fontSize=15;fontFamily=Courier New;align=center;verticalAlign=middle;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="940" y="8" width="254" height="26" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;ballot proofs&lt;/b&gt;&lt;div style='text-align:left;font-size:13px;line-height:1.3;margin-top:3px'&gt;&amp;bull; ballot verification key&lt;br&gt;&amp;bull; n Groth16 proofs with (address,&lt;br&gt;&amp;bull; &amp;nbsp;&amp;nbsp;voteID, inputsHash)&lt;br&gt;&amp;bull; n ECDSA signatures over the voteIDs&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="16" y="44" width="390" height="104" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;state transition&lt;/b&gt;&lt;div style='text-align:left;font-size:13px;line-height:1.3;margin-top:3px'&gt;&amp;bull; processID, old and new state roots&lt;br&gt;&amp;bull; n, w, occupiedBefore&lt;br&gt;&amp;bull; inclusion proofs of the five&lt;br&gt;&amp;bull; &amp;nbsp;&amp;nbsp;configuration leaves&lt;br&gt;&amp;bull; transition chains: vote IDs, ballots,&lt;br&gt;&amp;bull; &amp;nbsp;&amp;nbsp;refreshes, results accumulator&lt;br&gt;&amp;bull; new, overwritten and refreshed&lt;br&gt;&amp;bull; &amp;nbsp;&amp;nbsp;ballots; old accumulator&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="16" y="164" width="390" height="196" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;eligibility&lt;/b&gt;&lt;div style='text-align:left;font-size:13px;line-height:1.3;margin-top:3px'&gt;&amp;bull; n Merkle census proofs, or&lt;br&gt;&amp;bull; n CSP credentials (signature,&lt;br&gt;&amp;bull; &amp;nbsp;&amp;nbsp;weight, index)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="16" y="376" width="390" height="84" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;re-encryption&lt;/b&gt;&lt;div style='text-align:left;font-size:13px;line-height:1.3;margin-top:3px'&gt;&amp;bull; encryption key&lt;br&gt;&amp;bull; secret seed of the batch&lt;br&gt;&amp;bull; n original and re-encrypted ballots&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="16" y="476" width="390" height="104" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;blobs&lt;/b&gt;&lt;div style='text-align:left;font-size:13px;line-height:1.3;margin-top:3px'&gt;&amp;bull; processID, old state root&lt;br&gt;&amp;bull; KZG commitments of the blobs&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="16" y="596" width="390" height="84" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;ballot proof verification&lt;/b&gt;&lt;div style='font-size:13px;line-height:1.3;margin-top:3px'&gt;VK hash = leaf 0x07; batched Groth16 check&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Courier New;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="460" y="44" width="420" height="50" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;authentication&lt;/b&gt;&lt;div style='font-size:13px;line-height:1.3;margin-top:3px'&gt;key recovered from signature; address matches&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Courier New;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="460" y="102" width="420" height="50" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;state transition&lt;/b&gt;&lt;div style='text-align:left;font-size:13px;line-height:1.45;margin-top:4px'&gt;&amp;bull; configuration read under the old root&lt;br&gt;&amp;bull; key namespaces and slot binding&lt;br&gt;&amp;bull; chain of tree transitions&lt;br&gt;&amp;bull; re-encryption from the seed chain&lt;br&gt;&amp;bull; results accumulation&lt;br&gt;&amp;bull; silent refresh (count, disjoint, sorted)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Courier New;align=center;verticalAlign=top;spacingTop=8;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="460" y="164" width="420" height="196" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;census membership&lt;/b&gt;&lt;div style='font-size:13px;line-height:1.3;margin-top:3px'&gt;Merkle: one root, valid paths, no duplicates&lt;br&gt;CSP: one signer key; distinct addresses&lt;br&gt;and indexes&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Courier New;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="460" y="376" width="420" height="84" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;binding&lt;/b&gt;&lt;div style='font-size:13px;line-height:1.3;margin-top:3px'&gt;same processID, root and key in all blocks;&lt;br&gt;inputsHash recomputed; census address =&lt;br&gt;ballot address; stored ballot = verified&lt;br&gt;re-encryption&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Courier New;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="460" y="476" width="420" height="104" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;data blobs&lt;/b&gt;&lt;div style='font-size:13px;line-height:1.3;margin-top:3px'&gt;rebuild blob cells from verified state;&lt;br&gt;z&lt;sub&gt;b&lt;/sub&gt; from commitment, y&lt;sub&gt;b&lt;/sub&gt; = p&lt;sub&gt;b&lt;/sub&gt;(z&lt;sub&gt;b&lt;/sub&gt;); digest&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Courier New;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="460" y="596" width="420" height="84" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;verdict&lt;/b&gt;: ok = every group passed" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Courier New;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="520" y="702" width="300" height="40" as="geometry"/></mxCell><mxCell id="c19" value="ok, failMask" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Courier New;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="940" y="44" width="254" height="50" as="geometry"/></mxCell><mxCell id="c20" value="stateRoot&lt;sup&gt;old&lt;/sup&gt;,&lt;br&gt;stateRoot&lt;sup&gt;new&lt;/sup&gt;, numVotes,&lt;br&gt;numOverwrites,&lt;br&gt;occupiedBefore" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Courier New;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="940" y="164" width="254" height="96" as="geometry"/></mxCell><mxCell id="c21" value="censusRoot&lt;br&gt;(or CSP address)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Courier New;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="940" y="376" width="254" height="60" as="geometry"/></mxCell><mxCell id="c22" value="blobsDigest, nBlobs" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Courier New;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="940" y="596" width="254" height="50" as="geometry"/></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;startArrow=none;endSize=6;startSize=6;fontSize=10;fontFamily=Courier New;strokeColor=#000000;strokeWidth=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2403846153846154;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;startArrow=none;endSize=6;startSize=6;fontSize=10;fontFamily=Courier New;strokeColor=#000000;strokeWidth=1;labelBackgroundColor=#f