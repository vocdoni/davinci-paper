<mxfile host="drawio"><diagram name="batch-program" id="batch-program"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=none;strokeColor=#000000;fontFamily=Courier New;verticalAlign=top;align=center;spacingTop=4;spacingLeft=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1130" height="600" as="geometry"/></mxCell><mxCell id="c4" value="PRIVATE INPUT BLOCKS" style="text;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Courier New;align=center;verticalAlign=middle;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="300" height="22" as="geometry"/></mxCell><mxCell id="c5" value="GROUPS OF CONSTRAINTS" style="text;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Courier New;align=center;verticalAlign=middle;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="380" y="8" width="360" height="22" as="geometry"/></mxCell><mxCell id="c6" value="PUBLIC OUTPUTS" style="text;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Courier New;align=center;verticalAlign=middle;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="860" y="8" width="240" height="22" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;ballot proofs&lt;/b&gt;&lt;div style='text-align:left;font-size:9px;line-height:1.35;margin-top:3px'&gt;&amp;bull; ballot verification key&lt;br&gt;&amp;bull; n Groth16 proofs with (address, voteID, inputsHash)&lt;br&gt;&amp;bull; n ECDSA signatures over the voteIDs&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="300" height="84" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;state transition&lt;/b&gt;&lt;div style='text-align:left;font-size:9px;line-height:1.35;margin-top:3px'&gt;&amp;bull; processID, old and new state roots&lt;br&gt;&amp;bull; n, w, occupiedBefore&lt;br&gt;&amp;bull; inclusion proofs of 5 configuration leaves&lt;br&gt;&amp;bull; transition chains: vote IDs, ballots,&lt;br&gt;&amp;bull; &amp;nbsp;&amp;nbsp;refreshes, results accumulator&lt;br&gt;&amp;bull; new, overwritten and refreshed ballots,&lt;br&gt;&amp;bull; &amp;nbsp;&amp;nbsp;old accumulator&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="136" width="300" height="150" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;eligibility&lt;/b&gt;&lt;div style='text-align:left;font-size:9px;line-height:1.35;margin-top:3px'&gt;&amp;bull; n Merkle census proofs, or&lt;br&gt;&amp;bull; n CSP credentials (signature, weight, index)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="298" width="300" height="70" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;reencryption&lt;/b&gt;&lt;div style='text-align:left;font-size:9px;line-height:1.35;margin-top:3px'&gt;&amp;bull; encryption key&lt;br&gt;&amp;bull; secret seed of the batch&lt;br&gt;&amp;bull; n original and reencrypted ballots&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="380" width="300" height="84" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;blobs&lt;/b&gt;&lt;div style='text-align:left;font-size:9px;line-height:1.35;margin-top:3px'&gt;&amp;bull; processID, old state root&lt;br&gt;&amp;bull; KZG commitments of the blobs&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="476" width="300" height="70" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;ballot proof verification&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;VK hash = leaf 0x07; batched Groth16 check&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Courier New;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="40" width="380" height="40" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;authentication&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;recover key from signature; address matches&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Courier New;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="92" width="380" height="40" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;census membership&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;Merkle: one root, valid paths, no duplicates&lt;br&gt;CSP: one signer key, distinct addresses and indexes&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Courier New;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="298" width="380" height="52" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;state transition&lt;/b&gt;&lt;div style='text-align:left;font-size:9px;line-height:1.4;margin-top:3px'&gt;&amp;bull; configuration read under the old root&lt;br&gt;&amp;bull; key namespaces and slot binding&lt;br&gt;&amp;bull; chain of tree transitions&lt;br&gt;&amp;bull; reencryption from the seed chain&lt;br&gt;&amp;bull; results accumulation&lt;br&gt;&amp;bull; silent refresh (count, disjoint, sorted)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Courier New;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="380" y="144" width="380" height="142" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;data blobs&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;rebuild blob cells from verified state;&lt;br&gt;z&lt;sub&gt;b&lt;/sub&gt; from commitment, y&lt;sub&gt;b&lt;/sub&gt; = p&lt;sub&gt;b&lt;/sub&gt;(z&lt;sub&gt;b&lt;/sub&gt;); digest&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Courier New;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="476" width="380" height="52" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;binding&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;same processID, root and key in every block;&lt;br&gt;inputsHash recomputed; census address = ballot address;&lt;br&gt;stored ballot = verified reencryption&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Courier New;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="380" width="380" height="70" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;verdict&lt;/b&gt;: ok = every group passed" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Courier New;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="440" y="548" width="260" height="36" as="geometry"/></mxCell><mxCell id="c19" value="ok, failMask" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Courier New;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="4