xitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c55" target="c59"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c62" value="id" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Courier New;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1008" y="150" width="30" height="30" as="geometry"/></mxCell><mxCell id="c63" value="R&lt;sub&gt;r&lt;/sub&gt;" style="text;html=1;whiteSpace=wrap;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="928" y="184" width="110" height="22" as="geometry"/></mxCell><mxCell id="c64" value="voters' ballots (n), fields in order" style="text;html=1;whiteSpace=wrap;fontSize=9;fontFamily=Courier New;align=left;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="360" y="206" width="300" height="20" as="geometry"/></mxCell><mxCell id="c65" value="refreshed ballots (r), slots ascending" style="text;html=1;whiteSpace=wrap;fontSize=9;fontFamily=Courier New;align=left;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="820" y="206" width="250" height="20" as="geometry"/></mxCell><mxCell id="c66" value="each active ciphertext consumes the next scalar r&lt;sub&gt;t&lt;/sub&gt;; inactive fields (id) must be the identity and consume none. Example with n&lt;sub&gt;f&lt;/sub&gt; = 2." style="text;html=1;whiteSpace=wrap;fontSize=9;fontFamily=Courier New;align=left;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="16" y="130" width="330" height="70" as="geometry"/></mxCell><mxCell id="c67" value="&lt;b&gt;reencryption&lt;/b&gt; of a ciphertext with r&lt;sub&gt;t&lt;/sub&gt;:&lt;br&gt;(C&lt;sub&gt;1&lt;/sub&gt;, C&lt;sub&gt;2&lt;/sub&gt;) &amp;rarr; (C&lt;sub&gt;1&lt;/sub&gt; + r&lt;sub&gt;t&lt;/sub&gt;&amp;middot;G, C&lt;sub&gt;2&lt;/sub&gt; + r&lt;sub&gt;t&lt;/sub&gt;&amp;middot;encryptionKey)&lt;br&gt;&lt;font style='font-size:9px'&gt;no scalar repeats within a batch, nor across batches (the old root differs)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffffff;strokeColor=#000000;fontFamily=Courier New;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="16" y="236" width="500" height="76" as="geometry"/></mxCell><mxCell id="c68" value="&lt;b&gt;results accumulation&lt;/b&gt;&lt;br&gt;A&lt;sup&gt;new&lt;/sup&gt; = A&lt;sup&gt;old&lt;/sup&gt; + &amp;Sigma; B'&lt;sub&gt;i&lt;/sub&gt; &amp;minus; &amp;Sigma; B&lt;sup&gt;old&lt;/sup&gt;&lt;sub&gt;i&lt;/sub&gt; + &amp;Sigma; (R'&lt;sub&gt;j&lt;/sub&gt; &amp;minus; R&lt;sub&gt;j&lt;/sub&gt;)&lt;br&gt;&lt;font style='font-size:9px'&gt;new ballots, minus overwritten ballots, plus encryptions of zero from refreshes&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Courier New;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="540" y="236" width="560" height="76" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>