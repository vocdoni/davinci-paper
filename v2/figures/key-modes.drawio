lts)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;fillColor=#ffffff;strokeColor=#000000;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="740" y="238" width="220" height="132" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>