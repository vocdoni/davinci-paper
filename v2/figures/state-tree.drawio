;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="172" y="32" width="248" height="40" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;vote identifiers&lt;/b&gt;&lt;br&gt;one per ballot cast" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="420" y="32" width="230" height="40" as="geometry"/></mxCell><mxCell id="c21" value='&lt;font face="Courier New"&gt;0x0&lt;/font&gt; processID&lt;br&gt;&lt;font face="Courier New"&gt;0x2&lt;/font&gt; ballotMode&lt;br&gt;&lt;font face="Courier New"&gt;0x3&lt;/font&gt; H(encryptionKey)&lt;br&gt;&lt;font face="Courier New"&gt;0x4&lt;/font&gt; H(encrypted results)&lt;br&gt;&lt;font face="Courier New"&gt;0x6&lt;/font&gt; censusOrigin&lt;br&gt;&lt;font face="Courier New"&gt;0x7&lt;/font&gt; ballotVKHash&lt;br&gt;&lt;font color="#666666"&gt;other keys reserved&lt;/font&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="0" y="72" width="172" height="124" as="geometry"/></mxCell><mxCell id="c22" value='&lt;b&gt;key&lt;/b&gt; = slot&lt;br&gt;Merkle census: 0x10 + (h mod (2&lt;sup style="line-height:0"&gt;63&lt;/sup&gt; &amp;minus; 16)),&lt;br&gt;&amp;nbsp;&amp;nbsp;h = first 8 bytes of&lt;br&gt;&amp;nbsp;&amp;nbsp;H(&amp;quot;davinci-slot-v1&amp;quot; &amp;#8214; address)&lt;br&gt;CSP census: 0x10 + index&lt;br&gt;&lt;b&gt;value&lt;/b&gt; = H(re-encrypted ballot)&lt;br&gt;&lt;font color="#666666"&gt;written by votes and overwrites,&lt;br&gt;refreshed by silent re-encryptions&lt;/font&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="172" y="72" width="248" height="124" as="geometry"/></mxCell><mxCell id="c23" value='&lt;b&gt;key&lt;/b&gt; = voteID = 2&lt;sup style="line-height:0"&gt;63&lt;/sup&gt; + (v mod 2&lt;sup style="line-height:0"&gt;63&lt;/sup&gt;),&lt;br&gt;&amp;nbsp;&amp;nbsp;v = Poseidon(processID, address, k)&lt;br&gt;&lt;b&gt;value&lt;/b&gt; = 0&lt;br&gt;&lt;font color="#666666"&gt;insert-only: a vote identifier is never&lt;br&gt;reused; it lets a voter check that the&lt;br&gt;ballot was recorded without&lt;br&gt;revealing its slot&lt;/font&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="420" y="72" width="230" height="124" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>