<mxfile host="drawio"><diagram name="ballot-variables" id="ballot-variables"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c13" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=none;strokeColor=#000000;fontFamily=Courier New;verticalAlign=top;align=center;spacingTop=4;spacingLeft=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="640" height="236" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;&lt;u&gt;Ballot&lt;/u&gt;&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="16" y="16" width="80" height="30" as="geometry"/></mxCell><mxCell id="c4" value="v&lt;sub&gt;1&lt;/sub&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#000000;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="96" y="14" width="46" height="34" as="geometry"/></mxCell><mxCell id="c5" value="v&lt;sub&gt;2&lt;/sub&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#000000;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="142" y="14" width="46" height="34" as="geometry"/></mxCell><mxCell id="c6" value="v&lt;sub&gt;3&lt;/sub&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#000000;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="188" y="14" width="46" height="34" as="geometry"/></mxCell><mxCell id="c7" value="0" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="234" y="14" width="36" height="34" as="geometry"/></mxCell><mxCell id="c8" value="0" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="270" y="14" width="36" height="34" as="geometry"/></mxCell><mxCell id="c9" value="0" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="306" y="14" width="36" height="34" as="geometry"/></mxCell><mxCell id="c10" value="&amp;hellip; (16)" style="text;html=1;whiteSpace=wrap;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=middle;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="346" y="14" width="60" height="34" as="geometry"/></mxCell><mxCell id="c11" value="active fields (here n&lt;sub&gt;f&lt;/sub&gt; = 3) and inactive fields, always 0" style="text;html=1;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="96" y="50" width="400" height="20" as="geometry"/></mxCell><mxCell id="c12" value="&lt;div style='line-height:1.75'&gt;&amp;bull; &lt;b&gt;numFields&lt;/b&gt; = n&lt;sub&gt;f&lt;/sub&gt;: number of active fields (1 to 16); &lt;b&gt;groupSize&lt;/b&gt; &amp;le; numFields.&lt;br&gt;&amp;bull; &lt;b&gt;uniqueValues&lt;/b&gt; = true: v&lt;sub&gt;1&lt;/sub&gt;, v&lt;sub&gt;2&lt;/sub&gt;, v&lt;sub&gt;3&lt;/sub&gt; must be different; false: values may repeat.&lt;br&gt;&amp;bull; &lt;b&gt;minValue&lt;/b&gt; &amp;le; v&lt;sub&gt;1&lt;/sub&gt;, v&lt;sub&gt;2&lt;/sub&gt;, v&lt;sub&gt;3&lt;/sub&gt; &amp;le; &lt;b&gt;maxValue&lt;/b&gt;.&lt;br&gt;&amp;bull; &lt;b&gt;minValueSum&lt;/b&gt; &amp;le; v&lt;sub&gt;1&lt;/sub&gt;&lt;sup&gt;e&lt;/sup&gt; + v&lt;sub&gt;2&lt;/sub&gt;&lt;sup&gt;e&lt;/sup&gt; + v&lt;sub&gt;3&lt;/sub&gt;&lt;sup&gt;e&lt;/sup&gt; &amp;le; max, with e = &lt;b&gt;costExponent&lt;/b&gt; and&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;max = &lt;b&gt;maxValueSum&lt;/b&gt; if it is positive, or the voter's &lt;b&gt;weight&lt;/b&gt; if it is 0.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=top;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="16" y="84" width="608" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>